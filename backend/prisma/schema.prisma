generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Mascota {
  id        Int     @id @default(autoincrement())
  nombre    String
  especie   String
  raza      String?
  edad      Int?
  foto      String?
  userId    Int?
  user      Usuario? @relation(fields: [userId], references: [id], onDelete: Cascade)
  turnos    Turno[]
  createdAt String  @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@index([userId])
}

model Usuario {
  id            Int                 @id @default(autoincrement())
  nombre        String
  email         String              @unique
  password      String
  role          String              @default("USER")
  telefono      String?
  direccion     String?
  createdAt     String              @default(dbgenerated("CURRENT_TIMESTAMP"))
  mascotas      Mascota[]
  turnos        Turno[]
  notifications Notification[]
  pushTokens    NotificacionPush[]

  @@map("Usuario")
}

model Turno {
  id            Int            @id @default(autoincrement())
  tipo          String
  fecha         String
  hora          String
  recordatorioEnviadoEn String?
  userId        Int
  user          Usuario        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mascotaId     Int
  mascota       Mascota        @relation(fields: [mascotaId], references: [id], onDelete: Cascade)
  createdAt     String         @default(dbgenerated("CURRENT_TIMESTAMP"))
  notifications Notification[]

  @@index([userId])
  @@index([mascotaId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  turnoId   Int?
  title     String
  message   String
  readAt    String?
  createdAt String   @default(dbgenerated("CURRENT_TIMESTAMP"))
  user      Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
  turno     Turno?   @relation(fields: [turnoId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model NotificacionPush {
  token     String @id
  userId    Int
  createdAt String @default(dbgenerated("CURRENT_TIMESTAMP"))
  user      Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notificacionpush")
}