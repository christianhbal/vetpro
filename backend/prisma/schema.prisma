generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model Mascota {
  id        Int      @id @default(autoincrement())
  nombre    String
  especie   String
  createdAt DateTime @default(now())
}

model User {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("usuarios")
}