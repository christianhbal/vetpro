generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Sede {
  id        Int    @id @default(autoincrement())
  nombre    String @unique
  direccion String
  dias      String
  horaDesde String
  horaHasta String
}

model Mascota {
  id        Int     @id @default(autoincrement())
  nombre    String
  especie   String
  raza      String?
  // Macho o Hembra. Va suelto y no como parte de la especie porque la ficha
  // lo muestra solo y las otras pantallas no lo necesitan.
  sexo      String?
  fechaNacimiento String
  foto      String?
  userId    Int?
  user      Usuario? @relation(fields: [userId], references: [id], onDelete: Cascade)
  turnos    Turno[]
  createdAt String  @default(dbgenerated("CURRENT_TIMESTAMP"))

  @@index([userId])
}

model Usuario {
  id            Int                 @id @default(autoincrement())
  nombre        String
  email         String              @unique
  password      String
  role          String              @default("USER")
  telefono      String?
  createdAt     String              @default(dbgenerated("CURRENT_TIMESTAMP"))
  mascotas      Mascota[]
  turnos        Turno[]
  notifications Notification[]
  pushTokens    NotificacionPush[]

  @@map("Usuario")
}

model Turno {
  id            Int            @id @default(autoincrement())
  tipo          String
  sede          String         @default("Recoleta")
  fecha         String
  hora          String
  llegadaEn     String?
  atendidoEn    String?
  descripcion   String?
  esDemo        Boolean         @default(false)
  ocultoEnAgenda Boolean        @default(false)
  recordatorioEnviadoEn String?
  userId        Int
  user          Usuario        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mascotaId     Int
  mascota       Mascota        @relation(fields: [mascotaId], references: [id], onDelete: Cascade)
  createdAt     String         @default(dbgenerated("CURRENT_TIMESTAMP"))
  notifications Notification[]

  @@index([userId])
  @@index([mascotaId])
  @@unique([sede, fecha, hora])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  turnoId   Int?
  title     String
  message   String
  readAt    String?
  createdAt String   @default(dbgenerated("CURRENT_TIMESTAMP"))
  // Nombre y foto de la mascota, copiados del turno. Al cancelar, el turno se
  // borra y la relacion queda en null: sin esto el aviso de "Tu turno fue
  // cancelado" salia sin foto, distinto de todos los demas.
  mascotaNombre String?
  mascotaFoto   String?
  // Por que se cancelo, en palabras. Va aparte del mensaje porque el mensaje es
  // la linea corta de la lista y el motivo es lo que se abre al apretar.
  motivo        String?
  // Sede y hora del turno cancelado, copiadas por la misma razon que el nombre
  // y la foto: al cancelar el turno se borra y la relacion queda en null. Sin
  // esto el aviso de "Tu turno fue cancelado" no podria decir donde era el turno
  // que se cayo, y queda distinto de todos los demas.
  sede          String?
  hora          String?
  // Aviso general de la veterinaria ("feriado", "se muda de sede"). No es de
  // una mascota ni de un turno: la tarjeta lleva el logo de VetPro en vez de la
  // foto del paciente. Se marca para no adivinarlo en la app.
  esGlobal      Boolean   @default(false)
  // Tipo de aviso que necesita una accion del admin. Hoy solo 'recuperacion':
  // un usuario pidio restablecer su contraseña. El resto queda en null.
  tipo              String?
  // Correo del usuario que hizo la solicitud. Se copia aca para que el admin
  // pueda restablecer la contraseña sin tener que leer el mensaje.
  solicitanteEmail  String?
  user      Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
  turno     Turno?   @relation(fields: [turnoId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model NotificacionPush {
  token     String @id
  userId    Int
  createdAt String @default(dbgenerated("CURRENT_TIMESTAMP"))
  user      Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notificacionpush")
}
